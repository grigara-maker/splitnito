# --- Supabase (povinné) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Povinné pro e-mailové notifikace, mazání účtů a úklid storage.
SUPABASE_SERVICE_ROLE_KEY=

# --- Veřejná adresa aplikace ---
# Používá se v odkazech a QR kódech uvnitř e-mailů — musí být skutečná doména.
NEXT_PUBLIC_SITE_URL=https://splitnito.fun

# --- OCR účtenek ---
GEMINI_API_KEY=
# GEMINI_OCR_MODEL=

# --- Odesílání e-mailů ---
# Odesílatel musí být na ověřené doméně, jinak e-maily spadnou do spamu.
EMAIL_FROM=vyuctovani@splitnito.fun
EMAIL_FROM_NAME=Splitnito
# EMAIL_REPLY_TO=

# Varianta A – Resend (doporučeno, stačí API klíč a ověřená doména)
RESEND_API_KEY=

# Varianta B – vlastní SMTP (použije se, když není RESEND_API_KEY)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- Denní připomínky (Vercel Cron) ---
# Náhodný dlouhý řetězec; Vercel ho posílá v hlavičce Authorization.
CRON_SECRET=

# Volitelné: vlastní tajemství pro podpis odkazů v e-mailech.
# Bez něj se použije SUPABASE_SERVICE_ROLE_KEY.
# EMAIL_TOKEN_SECRET=
